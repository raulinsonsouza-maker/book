# Database (SQLite local — use PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Resend
RESEND_API_KEY=""
EMAIL_FROM="Book Symbius <agendamento@book.symbius.com.br>"

# Cron (POST /api/cron/booking-comms com header Authorization: Bearer …)
CRON_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google (login NextAuth + Google Calendar OAuth)
# Redirect login: {NEXTAUTH_URL}/api/auth/callback/google
# Redirect Calendar: {NEXT_PUBLIC_APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Mercado Pago OAuth (app Symbius — uma vez na plataforma)
# No painel MP: Detalhes da aplicação → Número da aplicação = CLIENT_ID
# Client Secret ≠ Public Key / Access Token de produção
# Redirect URL: {NEXTAUTH_URL}/api/mercadopago/callback
# Webhook: {NEXT_PUBLIC_APP_URL}/api/webhooks/mercadopago
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
MERCADOPAGO_REDIRECT_URI="http://localhost:3000/api/mercadopago/callback"
