generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  PIX
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CustomFieldType {
  TEXT
  NUMBER
  SELECT
  TEXTAREA
  PHONE
  CPF
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
}

model Organization {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  timezone           String        @default("America/Sao_Paulo")
  caktoClientId      String?
  caktoClientSecret  String?
  caktoSdkClientId   String?
  caktoOfferId       String?
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  googleEmail        String?
  googleCalendarId   String?       @default("primary")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  memberships        Membership[]
  bookingPages       BookingPage[]
}

model Membership {
  id             String         @id @default(cuid())
  role           MembershipRole @default(MEMBER)
  userId         String
  organizationId String
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model BookingPage {
  id             String              @id @default(cuid())
  organizationId String
  title          String
  slug           String              @unique
  description    String?
  logoUrl        String?
  accentColor    String              @default("#0a0a0a")
  websiteUrl     String?
  instagram      String?
  timezone       String              @default("America/Sao_Paulo")
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services       Service[]
  availability   AvailabilityRule[]
  exceptions     AvailabilityException[]
  bookings       Booking[]
  slotHolds      SlotHold[]
}

model Service {
  id              String        @id @default(cuid())
  bookingPageId   String
  title           String
  description     String?
  durationMinutes Int           @default(30)
  priceCents      Int           @default(0)
  caktoOfferId    String?
  bufferBefore    Int           @default(0)
  bufferAfter     Int           @default(0)
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bookingPage     BookingPage   @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)
  customFields    CustomField[]
  bookings        Booking[]
  slotHolds       SlotHold[]
}

model AvailabilityRule {
  id            String      @id @default(cuid())
  bookingPageId String
  dayOfWeek     Int
  startTime     String
  endTime       String
  bookingPage   BookingPage @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)

  @@index([bookingPageId, dayOfWeek])
}

model AvailabilityException {
  id            String      @id @default(cuid())
  bookingPageId String
  date          String
  isBlocked     Boolean     @default(true)
  startTime     String?
  endTime       String?
  bookingPage   BookingPage @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)

  @@index([bookingPageId, date])
}

model CustomField {
  id         String          @id @default(cuid())
  serviceId  String
  label      String
  type       CustomFieldType @default(TEXT)
  required   Boolean         @default(false)
  options    String?
  sortOrder  Int             @default(0)
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Booking {
  id              String        @id @default(cuid())
  bookingPageId   String
  serviceId       String
  status          BookingStatus @default(PENDING_PAYMENT)
  startAt         DateTime
  endAt           DateTime
  timezone        String
  customerName    String
  customerEmail   String
  customerPhone   String
  customerCpf     String?
  customAnswers   String?
  holdExpiresAt   DateTime?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  googleEventId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bookingPage     BookingPage   @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  payment         Payment?
  slotHold        SlotHold?

  @@index([bookingPageId, startAt])
  @@index([status, holdExpiresAt])
  @@index([customerEmail])
}

model Payment {
  id               String        @id @default(cuid())
  bookingId        String        @unique
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amountCents      Int
  currency         String        @default("BRL")
  caktoPaymentId   String?
  idempotencyKey   String        @unique
  pixQrCode        String?
  pixQrCodeBase64  String?
  pixExpiresAt     DateTime?
  rawResponse      String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model SlotHold {
  id            String      @id @default(cuid())
  bookingPageId String
  serviceId     String
  bookingId     String?     @unique
  startAt       DateTime
  endAt         DateTime
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  bookingPage   BookingPage @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  booking       Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingPageId, startAt, expiresAt])
}
